FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Common Python Data Science & AI libraries
# This speeds up execution by avoiding runtime installation
RUN pip install --no-cache-dir \
    google-generativeai \
    openai \
    anthropic \
    pandas \
    numpy \
    scipy \
    requests \
    beautifulsoup4 \
    python-dotenv \
    flask

# Set working directory
WORKDIR /workspace

# Copy execution server
COPY skills/codex/execution_server.py /execution_server.py

# Default command: Run the execution server
CMD ["python", "/execution_server.py"]
