[Unit]
Description=DAA Mainframe Service
After=network.target

[Service]
# Update 'User' if you want to run as a specific user (e.g. ubuntu, root)
User=root
WorkingDirectory=/opt/mainframe/mainframe
ExecStart=/opt/mainframe/mainframe/venv/bin/python main.py
Restart=always
Environment=PYTHONUNBUFFERED=1
# Add EnvironmentFile if you want to load .env from systemd
# EnvironmentFile=/opt/mainframe/mainframe/.env

[Install]
WantedBy=multi-user.target
