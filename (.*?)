", text)
    for i in range(1, len(blocks), 2):
        filename = blocks[i].strip()
        code_block = blocks[i+1].strip()
        if code_block.startswith("```"):
             parts = code_block.split("\n", 1)
             if len(parts) > 1: code_block = parts[1]
             else: code_block = ""
        if code_block.endswith("```"):
             code_block = code_block.rsplit("\n", 1)[0]
             
        abs_path = os.path.abspath(filename)
        if os.getcwd() not in abs_path: continue
        
        # Ensure directory exists
        os.makedirs(os.path.dirname(abs_path), exist_ok=True)
        with open(abs_path, "w", encoding="utf-8") as f:
             f.write(code_block)
        fixed_files.append(filename)
        
    if not fixed_files:
         return "❌ Auto-fixern hittade inga filer att fixa eller returnerade fel format. Se till att Gemini fungerar."
         
    # Commit changes
    branch_name = f"autofix-codex-{datetime.datetime.now().strftime('%Y%m%d%H%M%S')}"
    git_tool = GitTool()
    await loop.run_in_executor(None, git_tool._run_git, ["checkout", "main"])
    await loop.run_in_executor(None, git_tool._run_git, ["checkout", "-b", branch_name])
    await loop.run_in_executor(None, git_tool._run_git, ["add", "."])
    summary = f"Automated fixes by Codex AI for {len(selected_issues)} issues"
    await loop.run_in_executor(None, git_tool._run_git, ["commit", "-m", summary])
    push_result = await loop.run_in_executor(None, git_tool._run_git, ["push", "-u", "origin", branch_name])
    
    # Create PR via GitHub API
    pr_body = "This pull request was automatically generated by Freja Codex Auto-fix.\n\n### Resolved Issues:\n"
    for issue in selected_issues:
         pr_body += f"- Fixes #{issue['number']}: {issue['title']}\n"
         
    pr_data = {"title": "Codex Auto-fix: Resolved Issues", "head": branch_name, "base": "main", "body": pr_body}
    async with httpx.AsyncClient() as hc:
         resp = await hc.post(f"https://api.github.com/repos/{owner_repo}/pulls", headers=headers, json=pr_data)
         if resp.status_code == 201:
             pr_url = resp.json().get("html_url", "")
             return f"✅ Genererade fixar för {len(fixed_files)} filer! PR skapad: {pr_url}"
         else:
             return f"⚠️ Fixade {len(fixed_files)} filer på `{branch_name}`, men PR misslyckades: {resp.text}\nGit Push Ouptut: {push_result}"
             
class AuditAndFixSchema(BaseModel):
